{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashcenter.io/test-setup/v1/fleet.schema.json",
  "title": "DashCenter test-setup FleetConfig",
  "type": "object",
  "required": ["apiVersion", "kind", "dpus"],
  "additionalProperties": false,
  "properties": {
    "_comment":   { "type": "string" },
    "apiVersion": { "const": "dashcenter.io/test-setup/v1" },
    "kind":       { "const": "FleetConfig" },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": { "name": { "type": "string" } }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario":     { "type": "string" },
        "imageTag":     { "type": "string", "default": "dev" },
        "bindHost":     { "type": "string", "default": "127.0.0.1" },
        "network":      { "type": "string", "default": "dashcenter-fleet" },
        "tickInterval": { "type": "string", "default": "1s" }
      }
    },
    "dpus": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["deviceId", "grpcPort", "adminPort"],
        "additionalProperties": false,
        "properties": {
          "deviceId":  { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "grpcPort":  { "type": "integer", "minimum": 1, "maximum": 65535 },
          "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "scenario":  { "type": "string" },
          "imageTag":  { "type": "string" },
          "extraArgs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled":  { "type": "boolean" },
        "grpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode":     { "enum": ["embedded", "external", "container"] },
            "hostPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "address":  { "type": "string" }
          }
        }
      }
    }
  }
}
